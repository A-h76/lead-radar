    {
      "id": "3aec07db-d4bf-4249-9375-f23fa72603ee",
      "name": "Normalize: Company Sites",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        420
      ],
      "parameters": {
        "jsCode": "// apify~website-content-crawler returns { url, text, markdown, metadata: {title, description} }.\n// Title lives under metadata, not at the top level.\nconst rows = $input.all().map(i => i.json).filter(j => j && Object.keys(j).length);\nconst leads = rows.map(j => ({ json: {\n  title: (j.metadata && j.metadata.title) || j.title || 'Untitled',\n  description: j.text || j.markdown || '',\n  url: j.url || (j.metadata && j.metadata.canonicalUrl) || '',\n  platform: 'Company Site',\n}})).filter(x => x.json.url);\nreturn leads.length ? leads : [{ json: { __empty: 'Company Site', __raw: rows.length } }];"
      }
    },
    {
      "id": "554db642-ab51-49ef-bee1-e7b54bf791f8",
      "name": "Merge Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1480,
        210
