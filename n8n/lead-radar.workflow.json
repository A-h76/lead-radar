    {
      "id": "693544e3-0637-4e73-bd20-b76c6fce5b0c",
      "name": "Format Digest Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2180,
        520
      ],
      "parameters": {
        "jsCode": "const records = $input.first().json.records || [];\nconst rows = records.map(r => {\n  const f = r.fields;\n  return '<li><strong>' + f['Fit Score'] + '/10</strong> -- ' + f['Title'] + ' (' + f['Client/Company'] + ')<br/>' +\n    '<a href=\"' + f['Source URL'] + '\">View listing</a></li>';\n}).join('');\n\nreturn [{ json: {\n  count: records.length,\n  html: '<h2>' + records.length + ' strong lead(s) found today</h2><ul>' + rows + '</ul>'\n}}];"
      }
    },
