    {
      "id": "6ecdd4b7-9f26-46e4-9849-1b03bdc889a0",
      "name": "Normalize: Upwork",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        0
      ],
      "parameters": {
        "jsCode": "// Map the Upwork actor's output onto a common shape.\n// Apify returns [] for an empty/failed run; with alwaysOutputData the node\n// upstream hands us a single {} item. Emit a sentinel instead of nothing --\n// a Code node that returns [] stops its whole branch with no error.\nconst rows = $input.all().map(i => i.json).filter(j => j && Object.keys(j).length);\nconst leads = rows.map(j => ({ json: {\n  title: j.title || j.jobTitle || 'Untitled',\n  description: j.description || j.snippet || '',\n  url: j.url || j.link || '',\n  platform: 'Upwork',\n}})).filter(x => x.json.url);\nreturn leads.length ? leads : [{ json: { __empty: 'Upwork', __raw: rows.length } }];"
      }
    },
