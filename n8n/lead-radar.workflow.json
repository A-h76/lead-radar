    {
      "id": "78d84beb-b1e9-4943-839c-dc9ca36b8f9c",
      "name": "OpenAI: Score Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You are screening freelance leads for a writer with an MSc in Human Nutrition and Dietetics who works across two core pillars: (1) evidence-based nutrition and health content that requires clinical accuracy and primary-source research, and (2) technology, AI, SaaS and B2B content that explains complex products to non-expert audiences. White papers and long-form explainers are core work in either pillar. TIER A, score 7-10: work in either core pillar that needs genuine subject-matter literacy - clinical accuracy, research skill, or the ability to explain a technical product credibly. TIER B, score 4-6: general commercial writing she accepts but does not specialize in - SEO blog posts, website and About copy, product descriptions, e-commerce content, email and social copy, executive ghostwriting. Score toward 6 when the budget is strong or the client sits in a core niche. TIER C, score 1-3: content-mill work, unrelated industries, no-budget or spammy postings, unpaid guest posts, or sites that charge writers to publish. Return ONLY a JSON object with keys: client_name, need_summary (1-2 sentences), budget_signal (or Not specified), fit_score (integer 1-10), score_reasoning (1 sentence, specific about which pillar and tier and why), urgency (one of High, Medium, Low).' }, { role: 'user', content: 'Listing title: ' + $('Loop Leads').item.json.title + '\\n\\nListing text: ' + $('Loop Leads').item.json.description } ] }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "da81eaa2-89e1-4133-8b71-031d70056ea2",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2680,
        300
      ],
      "parameters": {
        "jsCode": "// The chat completion's message content is a JSON *string* -- parse it,\n// then attach the original scraped fields so nothing is lost.\nconst source = $('Loop Leads').item.json;\nconst content = $input.first().json.choices[0].message.content;\nlet ai;\ntry {\n  ai = JSON.parse(content);\n} catch (e) {\n  ai = {\n    client_name: 'Unknown',\n    need_summary: '',\n    budget_signal: 'Not specified',\n    fit_score: 0,\n    score_reasoning: 'AI response was not valid JSON -- check the prompt/model.',\n    urgency: 'Low',\n  };\n}\n\nreturn [{ json: {\n  title: source.title,\n  description: source.description,\n  url: source.url,\n  platform: source.platform,\n  client_name: ai.client_name,\n  need_summary: ai.need_summary,\n  budget_signal: ai.budget_signal,\n  fit_score: ai.fit_score,\n  score_reasoning: ai.score_reasoning,\n  urgency: ai.urgency,\n}}];"
      }
    },
