      "parameters": {
        "mode": "append",
        "numberInputs": 2
      }
    },
    {
      "id": "e35a71c1-1c24-4e7f-8d28-f4b56d5cfebf",
      "name": "Keyword Pre-Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        210
      ],
      "parameters": {
        "jsCode": "// Cheap filter BEFORE the OpenAI call, so scoring only runs on plausible leads.\n// Wide on purpose -- the model does the real tiering. Edit as niches shift.\nconst KEYWORDS = [\n  // Pillar 1: evidence-based nutrition & health\n  'medical', 'clinical', 'nutrition', 'dietitian', 'dietetics', 'health',\n  'healthcare', 'wellness', 'pharma', 'patient', 'peer-reviewed', 'evidence-based',\n  // Pillar 2: tech, SaaS, B2B, AI\n  'saas', 'b2b', 'technical writer', 'technology', 'software', 'api',\n  'developer', 'fintech', 'cybersecurity', 'machine learning', 'ai ', 'artificial intelligence',\n  // Core formats in either pillar\n  'white paper', 'whitepaper', 'long-form', 'explainer', 'research writer',\n  'thought leadership', 'case study', 'academic',\n  // Secondary tier -- let it through, let the model score it 4-6\n  'seo', 'blog', 'ghostwrit', 'copywriter', 'content writer', 'newsletter'\n];\n\nconst all = $input.all().map(i => i.json);\nconst empties = all.filter(j => j.__empty);\nconst leads = all.filter(j => !j.__empty);\n\n// ponytail: a FAILED/ABORTED Apify run also yields an empty dataset, so it\n// surfaces here rather than at the status check. Split the IF per terminal\n// status if you need to tell \"broken actor\" from \"no results today\".\nif (leads.length === 0) {\n  throw new Error(\n    'Every source returned 0 items (' +\n    empties.map(e => e.__empty).join(', ') +\n    '). Check the Apify actor IDs, the actor input schema, and APIFY_TOKEN.'\n  );\n}\n\n// Hard block: MSc in Nutrition, not an RD/RDN credential -- a posting that\n// demands one is an auto-rejection, so drop it before the paid OpenAI call.\n// \\bRDN?\\b is case-sensitive on purpose: lowercase \"rd\" is road/3rd/etc.\nconst NEEDS_RD = t => /\\bRDN?\\b/.test(t) || /registered dietitian|registered dietician/i.test(t);\n\nreturn leads\n  .filter(j => KEYWORDS.some(k => (j.title + ' ' + j.description).toLowerCase().includes(k)))\n  .filter(j => !NEEDS_RD(j.title + ' ' + j.description))\n  .map(json => ({ json }));"
      }
    },
