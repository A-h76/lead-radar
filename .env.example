# Gate for the whole site — a single shared password (see README for why
# this is enough for a one-client tool).
APP_PASSWORD=choose-a-password

# Optional but recommended in production: the secret used to sign the login
# session cookie (see lib/auth.ts). Without it, a fixed in-code pepper is
# used instead -- still keeps the cookie from literally *being* APP_PASSWORD,
# but a real per-deployment secret is stronger. Any long random string; set
# it once and leave it (changing it logs everyone out, on purpose).
AUTH_COOKIE_SECRET=

# Airtable. Without these, the site runs on in-memory sample data so it can
# be built/tested before the automation produces real leads.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# n8n webhook URL that starts the lead-hunt workflow (see /n8n/README.md).
# Without this, the "Run Lead Hunt" button runs in demo mode.
N8N_WEBHOOK_URL=

# Powers the website's own AI features directly (Role 2 "Analyze" on manual
# leads, Role 3 "Generate outreach draft") — separate from n8n's own copy of
# this same variable, which n8n needs independently (see /n8n/README.md).
# Without this, those two buttons show a clear "not configured" error.
OPENAI_API_KEY=

# Google Calendar integration (§8 -- see README's "Calendar setup" section
# for the full walkthrough). Without these three, the "Connect Google
# Calendar" control and call-scheduling are hidden/disabled -- everything
# else in the app works exactly as before.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Google Cloud OAuth
# client, e.g. https://your-domain.com/api/calendar/callback
# (http://localhost:3000/api/calendar/callback for local dev).
GOOGLE_REDIRECT_URI=
